# ─── Garmin Connect (integración directa, recomendada) ──────────────────
# Tus credenciales de Garmin Connect. Se leen SOLO en tu equipo desde
# .env.local (que está en .gitignore y nunca se sube a GitHub).
# Copia este archivo a .env.local y rellena tus datos:
#   cp .env.local.example .env.local
GARMIN_EMAIL=tu-email@ejemplo.com
GARMIN_PASSWORD=tu-contraseña-de-garmin

# ─── Strava (opcional, integración alternativa) ─────────────────────────
# Solo si prefieres usar Strava en lugar de Garmin.
# Crea tu app en https://www.strava.com/settings/api
STRAVA_CLIENT_ID=tu_client_id
STRAVA_CLIENT_SECRET=tu_client_secret
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=genera_un_secret_aleatorio
